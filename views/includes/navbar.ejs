<style>
  .navbar {
    align-items: center !important;
  }
  .nav-link:hover {
    color: #0d6efd;
    font-weight: 600;
  }
  .nav-link {
    font-size: 1.1rem;
  }
  .login {
    display: flex;
  }
  .login a {
    margin-left: 1rem;
  }
  .search-input {
    padding: 0.5rem 0 0.5rem 0.2rem;
    border-radius: 15px;
    width: 20rem;
    color: azure;
    border: 0.5px solid gray;
  }
  .search-btn {
    margin-left: 1rem;
    border-radius: 20px;
    padding: 0.5rem 0.9rem;
  }
  .navbar-brand i {
    font-size: 1.5rem;
  }

  @media (max-width: 991.98px) {
    .navbar-nav {
      width: 100%;
    }
    .search-wrapper {
      width: 100%;
      margin: 0.75rem 0;
    }
    .search-wrapper form {
      width: 100%;
    }
    .search-input {
      width: 100%;
      flex: 1;
    }
    .login {
      width: 100%;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
      padding-top: 0.5rem;
      border-top: 1px solid #dee2e6;
    }
    .login a {
      margin-left: 0;
    }
  }

  @media (max-width: 576px) {
    .navbar-brand span {
      display: none;
    }
    .search-btn {
      padding: 0.5rem 0.7rem;
    }
  }
</style>

<nav class="navbar navbar-expand-lg bg-body-tertiary sticky-top my-navbar">
  <div class="container-fluid container">
    <a class="navbar-brand" href="#"><i class="fa-solid fa-book-journal-whills"></i> <span>QuillCraft</span></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav me-auto">
        <li class="nav-item">
          <a class="nav-link active" aria-current="page" href="/stories">Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link active" href="/stories/new">Add New Story</a>
        </li>
      </ul>

      <div class="d-flex align-items-center gap-3 search-wrapper">
        <form action="/search" class="d-flex" role="search">
          <input type="text" placeholder="Search Here..." aria-label="search" class="form-control search-input" name="q">
          <button class="btn search-btn btn-danger" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
        </form>
      </div>

      <div class="login">
        <% if(!currUser) { %>
          <a class="nav-link" href="/signup"><b>Signup</b></a>
          <a class="nav-link" href="/login"><b>Login</b></a>
        <% } %>
        <% if(currUser) { %>
          <a class="nav-link" href="/logout"><b>Log out</b></a>
        <% } %>
      </div>
    </div>
  </div>
</nav>